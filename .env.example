# Application Port
PORT=3000

# PostgreSQL Database Connection String (Neon Cloud or Local Instance)
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# JWT Secret Key (Mandatory — application will fail fast on startup if missing)
JWT_SECRET=<generate_a_long_random_string_min_32_chars_e.g_via_openssl_rand_hex_32>